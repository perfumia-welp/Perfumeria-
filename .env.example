# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Only the publishable key (sb_publishable_…) belongs here. Never put a secret
# key (sb_secret_…) or service_role key in a VITE_ variable: everything
# prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Catalogue source (optional override: mock | live). Without it, production
# builds (npm run build) use the live company catalogue and the dev server and
# npm run build:mock use the mock catalogue. A failed live load shows an error
# with Retry, never mock products. Dev server only: ?catalog=live / ?catalog=mock.
# VITE_PRODUCT_SOURCE=

# Public site address for canonical, hreflang, Open Graph and sitemap URLs.
# Production (Hostinger): https://perfumira.net. Defaults to src/config/site.ts.
VITE_SITE_URL=https://perfumira.net

# Design comparison switches (Hero and product-card A/B/C). Set to true ONLY in
# the temporary Cloudflare preview's build variables. Never set it for the
# perfumira.net (Hostinger) production build. The dev server always shows them.
# VITE_ENABLE_DESIGN_PREVIEW=true

# ---------------------------------------------------------------------------
# Production server (server.mjs, Hostinger Node.js Web App) — SERVER ONLY.
# These are read by Node at runtime and are never part of the browser build.
# Never prefix them with VITE_. Set the real values in Hostinger's environment
# variables for the web app; never commit them.
# Without SMTP_PASS the site still runs and the contact form says sending is
# unavailable.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@perfumira.net
# The Titan mailbox password. Leave empty here; set it only in Hostinger.
SMTP_PASS=
MAIL_FROM=Perfumira Website <info@perfumira.net>
MAIL_TO=info@perfumira.net
# PORT is set by Hostinger. TRUST_PROXY is the number of proxies in front of
# the app (default 1), so the rate limit sees each visitor's own address.
# TRUST_PROXY=1
