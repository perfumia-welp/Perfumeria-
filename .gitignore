# Dependencies
node_modules/

# Build output (Hostinger builds dist/ itself with npm run build)
dist/
build/
.cache/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
coverage/

# Environment files: never commit real values. .env.example is the template.
.env
.env.*
.env.local
.env*
!.env.example

# npm is the deployment package manager (package-lock.json). The pnpm lockfile
# from local Figma Make tooling stays local so hosts never see two lockfiles.
pnpm-lock.yaml

# Logs
logs/
*.log
*-debug.log*

# Temporary and scratch files
.tmp-*
tmp/
temp/
*.tmp
*.bak
*.swp
.claude/
.claude-replay.*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Audit scripts: local dependencies, results and screenshots
/scripts/audit/output/
/scripts/audit/screenshots/
